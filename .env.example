# Copy this file to .env and fill in real values.

PORT=4000

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# How long a login lasts
JWT_EXPIRES_IN=7d

# Only needed if the website is hosted at a DIFFERENT address from this server.
# When this server serves the site itself (the default), you can ignore it.
# Comma-separated for several origins.
CORS_ORIGIN=http://localhost:5173

# Set to 1 when deployed behind a host's proxy (Render, Railway, Fly, nginx...).
# Leave at 0 when running locally.
TRUST_PROXY=0

# Optional: only allow sign-ups from your school's email domain, e.g. myschool.edu.ng
# Leave blank to allow any email.
ALLOWED_EMAIL_DOMAIN=

# SQLite database file
DB_PATH=./data/dedications.db

# Optional: create staff accounts automatically when the server starts. Useful on a host where you
# can't run commands. Existing accounts are never overwritten, and once the accounts exist you can
# delete the PASSWORD lines.
STAFF_1_NAME=
STAFF_1_EMAIL=
STAFF_1_PASSWORD=
STAFF_2_NAME=
STAFF_2_EMAIL=
STAFF_2_PASSWORD=
